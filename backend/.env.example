APP_ENV=development
DATABASE_URL=sqlite:///./libstock.db
JWT_SECRET_KEY=replace-with-a-random-secret-containing-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=libstock-api
JWT_AUDIENCE=libstock-web
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:4200"]
REFRESH_COOKIE_NAME=refresh_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
