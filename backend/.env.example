APP_ENV=development
GOOGLE_BOOKS_API_KEY=
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
JWT_SECRET_KEY=replace-with-a-random-secret-containing-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=libstock-api
JWT_AUDIENCE=libstock-web
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:4200"]
REFRESH_COOKIE_NAME=refresh_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Issue #42: worker separado. Sem host/remetente, a fila permanece pendente.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Issue #190: HTTPS no Render Free, sem serviço/worker pago.
# Localmente fica desativado até configurar chave e remetente verificado.
MAIL_TRANSPORT=smtp
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_TIMEOUT_SECONDS=10
NOTIFICATION_DELIVERY_IN_API=false
NOTIFICATION_DELIVERY_INTERVAL_SECONDS=30
